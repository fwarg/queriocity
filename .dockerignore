node_modules
dist
*.db
.env
# Live data and local copies of it: databases (with -wal/-shm), images and backups. `*.db` above only
# matches at the root, so without these every build uploaded them into the builder stage.
docker/data/**
!docker/data/global_news_rss_feeds.json
production
**/*.db
**/*.db-wal
**/*.db-shm
temp
docker/env.local

# Tests stay in git and still run in CI (which builds from a checkout, not from this image) —
# they just don't belong in the runtime image. The server runs from source, so without this
# the container carries every *.test.ts plus test-support/fake-openai.ts, a stub HTTP server
# that binds a port and is never imported by the app.
**/*.test.ts
**/*.test.tsx
**/test-support/
