{
  "name": "queriocity",
  "version": "0.17.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "dev:client": "vite dev --config vite.config.ts",
    "start": "bun run src/server/index.ts & vite dev --config vite.config.ts",
    "serve": "bun run src/server/index.ts",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4",
    "@hono/zod-validator": "^0.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^7",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^5",
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "pdf-parse": "^2",
    "playwright": "^1.62.1",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sqlite-vec": "^0.1",
