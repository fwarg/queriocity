    "bun-types": "latest",
    "eslint": "9",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript-eslint": "^8.65.0",
    "vite": "^8",
    "vite-plugin-pwa": "^1.3.0"
  },
