# Environment variables reference. Copy to env.local (Docker) or .env (local dev) and fill in values.
# For local dev, omit DB_PATH (defaults to ./queriocity.db).

# Server
# Generate with: openssl rand -base64 32
JWT_SECRET=
# CORS allowed origin. Unset = same-origin only (the default, and correct for every normal
# deployment — the browser client is always served from the same origin as the API).
# Set only if a separate front end on another origin must call this API.
# ALLOWED_ORIGIN=https://yourdomain.example

# Set to false ONLY for local http development. When true (the default) the session cookie
# is marked Secure, so a browser will refuse to store it over plain http.
# COOKIE_SECURE=false

# Set to true when running behind a reverse proxy that sets X-Forwarded-For (nginx, Caddy…).
# Login/registration rate limits are keyed on the client address: without this the proxy's
# own address is used and every user shares one bucket; with it set while NOT behind a
# proxy, clients could forge the header to dodge the limit. Match it to reality.
# TRUST_PROXY=true

# Per-user request ceilings, per minute. 0 disables an individual limit.
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_SUGGEST_PER_MIN=60
# RATE_LIMIT_IMAGE_PER_MIN=10
# RATE_LIMIT_INGEST_PER_MIN=10

# Database — path inside container; mount a volume to /data
DB_PATH=/data/queriocity.db

# Unified base URL (e.g. litellm, ollama). If set, used as default for all providers unless overridden.
# For ollama, point at its OpenAI-compatible endpoint (http://host:11434/v1), not the native
# /api path — a /api or bare-host URL is rewritten to /v1 automatically, with a startup warning.
# BASE_PROVIDER defaults to 'openai'.
# BASE_URL=
# BASE_PROVIDER=openai

# Chat LLM
CHAT_PROVIDER=openai
CHAT_BASE_URL=
CHAT_MODEL=
# CHAT_API_KEY=sk-placeholder

# Thinking/reasoning LLM for researcher phase (falls back to chat if not set)
# THINKING_PROVIDER=openai
# THINKING_BASE_URL=
# THINKING_MODEL=
# THINKING_API_KEY=sk-placeholder

# Embedding LLM (falls back to chat server if not set)
EMBED_PROVIDER=openai
EMBED_BASE_URL=
EMBED_MODEL=
# EMBED_API_KEY=sk-placeholder
# Set embed_dimensions to the correct value for your embedding model
EMBED_DIMENSIONS=1024

# Small LLM for query reformulation (falls back to chat provider if not set)
SMALL_PROVIDER=openai
SMALL_BASE_URL=
SMALL_MODEL=
# SMALL_API_KEY=sk-placeholder

# Flash mode model override: 'small' uses SMALL_MODEL, otherwise uses CHAT_MODEL
# FLASH_MODEL=small

# Reranker — optional cross-encoder for result reranking (improves thorough mode and upload search)
# Set RERANK_MODEL to enable. RERANK_BASE_URL defaults to BASE_URL if omitted.
# RERANK_BASE_URL=
# RERANK_MODEL=
# Reranking is an optimisation and falls back to the original order, so it gives up quickly.
# RERANK_TIMEOUT_MS=30000

# Image generation
# Setting IMAGE_BASE_URL is what enables Image mode; nothing below matters without it. Point it at
# a diffusion server (ComfyUI, A1111, stable-diffusion.cpp, …); IMAGE_API picks which routes to use.
# IMAGE_BASE_URL=http://host.docker.internal:8188

# Request dialect the diffusion server speaks. "openai" (default) posts to /v1/images/generations
# and works anywhere, but the OpenAI image schema has no step-count or seed field, so servers drop
# both and the quality tiers below do nothing. "sdapi" posts the A1111 shape to /sdapi/v1/txt2img,
# where steps and seed are first-class — use it if your server exposes that route (A1111,
# stable-diffusion.cpp, and most forks do).
# IMAGE_API=sdapi

# Guidance/CFG scale, sdapi only. Unset leaves the server's own default; FLUX-class models
# generally want a lower value than the SD-era default of 7.
# IMAGE_CFG_SCALE=

# Optional model name or alias forwarded to the diffusion server. Left unset, the server picks its
# own default. Worth setting even if you only run one model: it is recorded in the provenance
# metadata of every generated image, and the app cannot know which default the server chose.
# IMAGE_MODEL=

# Inference steps behind the draft/balanced/high quality hints. The right values belong to the
# model, not to this app: a timestep-distilled model (schnell, turbo, LCM) is done in a handful of
# steps, an SD1.5-era one wants 25+. Defaults below suit a guidance-distilled FLUX-class model.
# Non-numeric or zero values fall back to the defaults rather than reaching the diffusion server.
# Edits scale these up by 1/strength so a light change still gets a full render — see the README.
# IMAGE_STEPS_DRAFT=8
# IMAGE_STEPS_BALANCED=16
# IMAGE_STEPS_HIGH=24

# Timeout for image generation/edit calls. Generous by default because diffusion is slow;
# it exists to catch a stuck server, not to bound normal renders. Default 300000 ms (5 min).
# IMAGE_TIMEOUT_MS=300000

# Where generated images are written. compose.yml sets this to /images and mounts ./data/images
# there; the code default (/tmp/queriocity/images) is inside the container, so images would be
# lost on every restart.
# IMAGE_STORAGE_DIR=/images

# SearXNG
SEARXNG_URL=
# Categories queried when the user hasn't picked any in the UI. SearXNG otherwise defaults to
# `general` alone, so engines you have enabled under another category are NEVER queried — a
# working news engine can sit unused while the general engines return nothing useful.
# Check which categories your engines are registered under before setting this.
# SEARCH_DEFAULT_CATEGORIES=general,news
# Timeout for a SearXNG (and keyed-API fallback) query. On timeout the search returns no
# results rather than hanging the chat request. Default 20000 ms.
# SEARCH_TIMEOUT_MS=20000

# Keyed search-API fallback (optional). Tops up a weak SearXNG result (e.g. engines suspended
# on a blocked exit IP) on either of two conditions — fewer than SEARCH_API_MIN_RESULTS results,
# or no engine from SEARCH_MAJOR_ENGINES contributed — and is capped per request/monitor-run so
# a fully-blocked task can't rack up cost. Leave unset to disable (SearXNG-only, default).
# SEARCH_API_PROVIDER=mojeek          # currently only: mojeek
# SEARCH_API_KEY=                     # your provider API key
# SEARCH_API_MAX_PER_REQUEST=3        # max paid fallback calls per request/run (0 disables)
# SEARCH_API_MIN_RESULTS=3            # top up via the API when SearXNG returns fewer than N results (1 = empty-only)
# List YOUR broad, general-purpose SearXNG engines here to enable a second top-up rule: the API
# is also called when none of them contributed, however many results came back — a full page from
# a niche index alone (e.g. an indie-web index that carries no news) looks healthy but answers
# nothing. Empty (the default) leaves that rule off; no engine names are assumed by the code.
# Names match their parent, so listing "brave" also covers "brave.news".
# ⚠ When your main engines are blocked this fires on nearly every search, so raise
# SEARCH_API_MAX_PER_REQUEST accordingly — otherwise the budget is spent during the pre-search
# and the agentic steps get none. Each call is billed.
# SEARCH_MAJOR_ENGINES=duckduckgo,brave,startpage,mojeek,bing,google

# URL fetching (optional proxy for the fetch_url tool)
# FETCH_PROXY_URL=socks5://127.0.0.1:9050
# URL fetching refuses loopback, private (RFC1918/CGNAT), link-local (incl. 169.254.169.254
# cloud metadata) and non-http(s) targets, on the original URL and on every redirect hop.
# This matters because the model can be talked into fetching a URL by content it reads —
# without the guard, a planted link reaches your Ollama/SearXNG/LiteLLM instances.
# Set to true ONLY if you deliberately fetch internal pages (e.g. an intranet wiki).
# FETCH_ALLOW_PRIVATE_HOSTS=true
# Timeout per fetch attempt (static, then Playwright), so an unreachable page costs at most
# roughly double this before the model is told it failed. Default 10000 ms.
# FETCH_TIMEOUT_MS=10000

# How long a generation keeps running after the client's connection drops, waiting for it to
# reconnect and pick the answer up where it left off. Default 90000 ms.
# STREAM_RESUME_GRACE_MS=90000
# FETCH_MAX_CHARS=100000            # raw per-fetch scrape/cache ceiling ONLY (stripped-HTML text, before any context
#                                    # budgeting). Does NOT control what reaches the model — see FETCH_MAX_URL_CONTEXT_CHARS
#                                    # and CONTEXT_TOKEN_LIMIT below, which cap context-injected content uniformly for
#                                    # both pasted URLs and URLs the model fetches itself via the fetch_url tool. Safe to
#                                    # raise this independently for scraping/caching without risking context overflow.
#                                    # Must stay >= FETCH_MAX_URL_CONTEXT_CHARS or the context cap/summarizer below never
#                                    # trigger — a startup warning is logged if misconfigured.
# FETCH_MAX_PAGES=8                 # max paginated pages fetched per URL (default: 8; overridable in Admin → Settings; prefetch path only)
# FETCH_MAX_URL_CONTEXT_CHARS=40000 # hard per-URL cap on content injected into the model's context (default: 40000; applies to pasted URLs AND the fetch_url tool)
# FETCH_SUMMARIZE_MAX_CHUNKS=6      # max chunks when summarising oversized URL content (Admin → Settings "summarize overflow" toggle; default: 6)

# Max chars of prior conversation passed to the reformulate model (keeps small-model context bounded). Requires ~4 chars/token.
# REFORMULATE_USER_CTX=400
# REFORMULATE_ASSISTANT_CTX=1000

# Context window of the main chat/thinking model in tokens. Used to trim conversation history and to budget URL/search
# content — including a cumulative running budget across every fetch_url/web_search call the model makes within a
# single research turn, so an agentic research run can't silently balloon the prompt regardless of FETCH_MAX_CHARS.
# A fixed fraction of this budget is reserved for that tool budget BEFORE history trimming runs (see
# TOOL_BUDGET_RESERVE_FRACTION below), so a long conversation can't leave the tools with no room left.
# ⚠ DEFAULT IS 8192 — set this to your actual model context or history will be over-trimmed.
# Examples: 32768 (32k), 131072 (128k), 200000 (200k).
# CONTEXT_TOKEN_LIMIT=32768

# Fraction of the input budget (CONTEXT_TOKEN_LIMIT × 0.8) reserved for agentic tool (web_search/fetch_url)
# results during balanced/thorough research turns, held back from conversation-history trimming so a long
# chat can never starve the tools of room to work. Default 0.3 (30% reserved for tools; history gets the
# remaining 70% before trimming — or compression, see Admin → Settings "Compress dropped history" — kicks in).
# TOOL_BUDGET_RESERVE_FRACTION=0.3

# Context window of the small utility model, in tokens. Used to derive a safe per-call input chunk
# size (SMALL_MODEL_INPUT_CHARS in llm.ts) for query reformulation, URL summarisation, suggestions,
# and — as of the history-compression feature above — chunking dropped conversation history before
# it's summarized. This is a client-side accounting number only: it is never sent to the small-model
# server, so it must match what that server is actually configured with (e.g. Ollama's num_ctx,
# llama.cpp's --ctx-size) or these calls can themselves overflow the small model's real context.
# ⚠ DEFAULT IS 4096 — set this to your actual small model's context, not the main model's.
# SMALL_MODEL_CONTEXT_TOKENS=4096

# Max output tokens for flash mode responses. Default 200 (intentionally terse).
# FLASH_MAX_TOKENS=200

# Max output tokens for balanced/thorough research, the writer, and synthesis fallbacks.
# Backstop against runaway generation (esp. thinking-model reasoning loops); covers
# reasoning + answer tokens together. Default 6000.
# RESEARCH_MAX_TOKENS=6000